<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/iv_child_status_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_parental_shield"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_welcome_child"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Kid"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_monitoring_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoring: Active"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="32dp" />

        <!-- Permission Checklist Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Permissions"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp" />

                <!-- Accessibility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accessibility Service" />
                    <TextView
                        android:id="@+id/status_accessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Granted"
                        android:textColor="#4CAF50"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Notifications -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notification Listener" />
                    <TextView
                        android:id="@+id/status_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Denied"
                        android:textColor="#F44336"
                        android:textStyle="bold" />
                </LinearLayout>


                <!-- Usage Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Usage Statistics" />
                    <TextView
                        android:id="@+id/status_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Granted"
                        android:textColor="#4CAF50"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Draw Over Apps" />
                    <TextView
                        android:id="@+id/status_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Denied"
                        android:textColor="#F44336"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Device Admin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Device Admin" />
                    <TextView
                        android:id="@+id/status_device_admin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Denied"
                        android:textColor="#F44336"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_fix_permissions"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Fix Issues"
            android:visibility="gone"
            app:cornerRadius="28dp" />

        <TextView
            android:id="@+id/tv_child_device_id_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device ID: 123456"
            android:textSize="12sp"
            android:alpha="0.5"
            android:layout_marginTop="16dp" />

    </LinearLayout>


</LinearLayout>
